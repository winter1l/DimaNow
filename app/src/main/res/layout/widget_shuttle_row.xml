<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- 목적지 태그 (앱 홈 캡슐 좌측 태그와 동일한 역할) -->
    <TextView
        android:id="@+id/shuttle_row_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_tag_bg"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:paddingStart="8dp"
        android:paddingTop="5dp"
        android:paddingEnd="8dp"
        android:paddingBottom="5dp"
        android:textColor="@color/widget_tag_text"
        android:textSize="@dimen/widget_text_caption" />

    <!--
        Departure capsules. The provider picks the fill and text color per tone
        (nearest primary, later soft container, last service error; D-040/D-083/D-016)
        from resources, so the launcher still resolves the night variants.
    -->
    <TextView
        android:id="@+id/shuttle_row_capsule1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:background="@drawable/widget_capsule_next_bg"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingStart="6dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp"
        android:textColor="@color/widget_on_accent"
        android:textSize="@dimen/widget_text_caption"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/shuttle_row_capsule2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:background="@drawable/widget_capsule_bg"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingStart="6dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp"
        android:textColor="@color/widget_text_primary"
        android:textSize="@dimen/widget_text_caption"
        android:textStyle="bold" />
</LinearLayout>
