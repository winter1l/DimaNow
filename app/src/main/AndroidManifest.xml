<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- WorkManager merges this for foreground workers; DIMA Now never starts a foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />

    <!-- D-121: predictive back (the in-app back preview and the system back-to-home animation) on Android 13-15 too;
         targetSdk 36 already turns it on for Android 16. All Back handling goes through the OnBackPressedDispatcher. -->
    <application
        android:name=".DimaNowApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.DIMANow">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- D-128(2): 셔틀, 식단, 외출·외박 신청 and 모바일 열람증 from a long press on the launcher icon. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <!-- D-128(2): the 다음 셔틀 Quick Settings tile; informational, a tap opens the 셔틀 tab. -->
        <service
            android:name=".widget.ShuttleTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_shuttle"
            android:label="@string/shuttle_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>
        <!-- D-112: reads only KakaoTalk 점호 announcements, once the student allows notification access. -->
        <service
            android:name=".dorm.KakaoRollCallListener"
            android:exported="true"
            android:label="@string/kakao_roll_call_listener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <meta-data
                android:name="android.service.notification.default_filter_types"
                android:value="conversations|alerting" />
        </service>
        <receiver
            android:name=".location.CampusGeofenceReceiver"
            android:exported="false" />
        <receiver
            android:name=".widget.ShuttleWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/shuttle_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.MealWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/meal_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.CampusSummaryWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/campus_summary_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.SharedWidgetMinuteReceiver"
            android:exported="false" />
        <receiver
            android:name=".live.GuidanceAlarmReceiver"
            android:exported="false" />
        <receiver
            android:name=".live.DismissGuidanceReceiver"
            android:exported="false" />
        <receiver
            android:name=".live.RescheduleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".live.LiveMinuteUpdateReceiver"
            android:exported="false" />
        <receiver
            android:name=".dorm.OutingReminderReceiver"
            android:exported="false" />
    </application>

    <!-- D-126(6): the 전체 tab opens the library app (모바일 열람증) and 헤이영 (전자출결); Android 11+ hides other
         apps unless they are named here. -->
    <queries>
        <package android:name="kr.ac.dima.lib" />
        <package android:name="com.shinhan.heyoung" />
    </queries>

</manifest>
