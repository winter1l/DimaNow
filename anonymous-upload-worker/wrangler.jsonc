{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dima-now-meal-upload",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["7,37 0-4 * * MON", "7 5-23/2 * * MON", "7 1-23/2 * * SUN,TUE,WED,THU,FRI,SAT"]
  },
  "vars": {
    "GITHUB_APP_ID": "4774955",
    "GITHUB_INSTALLATION_ID": "157828401",
    "GITHUB_OWNER": "winter1l",
    "GITHUB_REPOSITORY": "DimaNow",
    "GITHUB_SUBMISSION_BRANCH": "dorm-submissions",
    "UPLOAD_DAILY_LIMIT": "20",
    "UPLOAD_WEEKLY_LIMIT": "40"
  },
  "d1_databases": [
    {
      "binding": "SHUTTLE_REPORTS",
      "database_name": "dima-now-shuttle-reports",
      "database_id": "95ba29ac-6838-40cc-bb74-04a36dd9e32d",
      "migrations_dir": "migrations"
    }
  ]
}
